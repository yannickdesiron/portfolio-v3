---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<figure class="snake">
  <div
    class="snake-board"
    id="snake"
    tabindex="0"
    role="application"
    aria-label="Snake"
    data-label-start={t.notFound.start}
    data-label-paused={t.notFound.paused}
    data-label-over={t.notFound.gameOver}
    data-label-again={t.notFound.again}
  >
    <canvas id="snake-canvas"></canvas>
    <p class="snake-overlay" id="snake-overlay">{t.notFound.start}</p>
  </div>
  <figcaption class="snake-scores">
    <span>{t.notFound.score}: <b id="snake-score">0</b></span>
    <span>{t.notFound.best}: <b id="snake-best">0</b></span>
  </figcaption>
</figure>

<script>
  const CELL = 22; // one grid square
  const COLS = 21;
  const ROWS = 13;
  const START_STEP = 150; // ms per move, drops as you eat
  const MIN_STEP = 70;

  type Point = { x: number; y: number };

  function initSnake() {
    const board = document.getElementById('snake');
    const canvas = document.getElementById('snake-canvas') as HTMLCanvasElement | null;
    const overlay = document.getElementById('snake-overlay');
    const scoreOut = document.getElementById('snake-score');
    const bestOut = document.getElementById('snake-best');
    if (!board || !canvas || !overlay || !scoreOut || !bestOut) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let snake: Point[] = [];
    let dir: Point = { x: 1, y: 0 };
    let queued: Point[] = [];
    let food: Point = { x: 0, y: 0 };
    let score = 0;
    let step = START_STEP;
    let last = 0;
    let acc = 0;
    let raf = 0;
    let state: 'idle' | 'running' | 'paused' | 'over' = 'idle';

    let best = 0;
    try { best = Number(localStorage.getItem('snake-best') ?? '0') || 0; } catch {}
    bestOut.textContent = String(best);

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = COLS * CELL * dpr;
    canvas.height = ROWS * CELL * dpr;
    canvas.style.width = `${COLS * CELL}px`;
    canvas.style.height = `${ROWS * CELL}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const token = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

    const dropFood = () => {
      const free: Point[] = [];
      for (let x = 0; x < COLS; x += 1) {
        for (let y = 0; y < ROWS; y += 1) {
          if (!snake.some((s) => s.x === x && s.y === y)) free.push({ x, y });
        }
      }
      food = free[Math.floor(Math.random() * free.length)] ?? { x: 0, y: 0 };
    };

    const reset = () => {
      snake = [
        { x: 5, y: 6 },
        { x: 4, y: 6 },
        { x: 3, y: 6 },
      ];
      dir = { x: 1, y: 0 };
      queued = [];
      score = 0;
      step = START_STEP;
      acc = 0;
      scoreOut.textContent = '0';
      dropFood();
    };

    const draw = () => {
      const pixel = document.documentElement.dataset.style === 'pixel';
      const round = pixel ? 0 : 5;
      ctx.clearRect(0, 0, COLS * CELL, ROWS * CELL);

      // the same dot grid the page uses, as the playfield
      ctx.fillStyle = token('--dot', 'rgba(255,255,255,.12)');
      for (let x = 0; x < COLS; x += 1) {
        for (let y = 0; y < ROWS; y += 1) {
          ctx.beginPath();
          ctx.arc(x * CELL + CELL / 2, y * CELL + CELL / 2, 1.3, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // food
      ctx.fillStyle = token('--court', '#fb7185');
      const fx = food.x * CELL + CELL / 2;
      const fy = food.y * CELL + CELL / 2;
      if (pixel) ctx.fillRect(fx - 6, fy - 6, 12, 12);
      else {
        ctx.beginPath();
        ctx.arc(fx, fy, 6, 0, Math.PI * 2);
        ctx.fill();
      }

      // snake, head brightest
      snake.forEach((part, i) => {
        ctx.fillStyle = i === 0 ? token('--accent', '#fb923c') : token('--accent-soft', '#3b2410');
        if (i > 0) ctx.globalAlpha = Math.max(0.35, 1 - i / (snake.length + 4));
        const x = part.x * CELL + 2;
        const y = part.y * CELL + 2;
        const size = CELL - 4;
        if (round) {
          ctx.beginPath();
          ctx.roundRect(x, y, size, size, round);
          ctx.fill();
        } else {
          ctx.fillRect(x, y, size, size);
        }
        ctx.globalAlpha = 1;
      });
    };

    const setOverlay = (text: string | null) => {
      overlay.textContent = text ?? '';
      overlay.hidden = !text;
    };

    const gameOver = () => {
      state = 'over';
      if (score > best) {
        best = score;
        bestOut.textContent = String(best);
        try { localStorage.setItem('snake-best', String(best)); } catch {}
      }
      setOverlay(`${board.dataset.labelOver} — ${board.dataset.labelAgain}`);
    };

    const advance = () => {
      const next = queued.shift();
      if (next) dir = next;
      const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

      const hitWall = head.x < 0 || head.y < 0 || head.x >= COLS || head.y >= ROWS;
      const hitSelf = snake.some((s) => s.x === head.x && s.y === head.y);
      if (hitWall || hitSelf) return gameOver();

      snake.unshift(head);
      if (head.x === food.x && head.y === food.y) {
        score += 1;
        scoreOut.textContent = String(score);
        step = Math.max(MIN_STEP, step - 4);
        dropFood();
      } else {
        snake.pop();
      }
    };

    const loop = (now: number) => {
      raf = 0;
      if (state !== 'running') return;
      acc += now - (last || now);
      last = now;
      while (acc >= step) {
        acc -= step;
        advance();
        if (state !== 'running') break;
      }
      draw();
      if (state === 'running' && !document.hidden) raf = requestAnimationFrame(loop);
    };

    const run = () => {
      if (state === 'running') return;
      if (state === 'over' || state === 'idle') reset();
      state = 'running';
      setOverlay(null);
      last = 0;
      if (!raf) raf = requestAnimationFrame(loop);
    };

    const pause = () => {
      if (state !== 'running') return;
      state = 'paused';
      cancelAnimationFrame(raf);
      raf = 0;
      setOverlay(board.dataset.labelPaused ?? 'paused');
    };

    const turn = (x: number, y: number) => {
      run(); // any direction key also starts the game
      const from = queued.length ? queued[queued.length - 1] : dir;
      if (from.x === -x && from.y === -y) return; // no instant reverse
      if (from.x === x && from.y === y) return; // already going that way
      if (queued.length < 2) queued.push({ x, y });
    };

    const KEYS: Record<string, Point> = {
      ArrowUp: { x: 0, y: -1 }, ArrowDown: { x: 0, y: 1 },
      ArrowLeft: { x: -1, y: 0 }, ArrowRight: { x: 1, y: 0 },
      w: { x: 0, y: -1 }, s: { x: 0, y: 1 }, a: { x: -1, y: 0 }, d: { x: 1, y: 0 },
    };

    board.addEventListener('keydown', (event) => {
      const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
      if (key === ' ') {
        event.preventDefault();
        state === 'running' ? pause() : run();
        return;
      }
      const move = KEYS[key];
      if (!move) return;
      event.preventDefault(); // arrows must not scroll the page while playing
      turn(move.x, move.y);
    });

    board.addEventListener('click', () => {
      board.focus();
      state === 'running' ? pause() : run();
    });

    // swipe for touch
    let touch: Point | null = null;
    board.addEventListener('touchstart', (event) => {
      const t = event.changedTouches[0];
      touch = { x: t.clientX, y: t.clientY };
    }, { passive: true });
    board.addEventListener('touchend', (event) => {
      if (!touch) return;
      const t = event.changedTouches[0];
      const dx = t.clientX - touch.x;
      const dy = t.clientY - touch.y;
      touch = null;
      if (Math.abs(dx) < 24 && Math.abs(dy) < 24) return;
      if (Math.abs(dx) > Math.abs(dy)) turn(dx > 0 ? 1 : -1, 0);
      else turn(0, dy > 0 ? 1 : -1);
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause();
    });
    // a skin or theme switch changes every colour on the board
    new MutationObserver(() => draw()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-style'],
    });

    reset();
    draw();
  }

  document.addEventListener('astro:page-load', initSnake);
</script>
