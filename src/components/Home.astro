---
import Layout from '../layouts/Layout.astro';
import ParticleText from './ParticleText.astro';
import SkinIcon from './SkinIcon.astro';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import courtPhoto from '../assets/court.jpg';
import { formatPeriod, pathFor, useTranslations, type Lang } from '../i18n';
import { experience, groupExperience } from '../data/experience';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = t.projects.items.map((item, i) => ({
  ...item,
  level: String(i + 1).padStart(2, '0'),
  stack: [
    ['PHP', 'MySQL', 'Docker', 'REST'],
    ['Astro', 'TypeScript', 'Tailwind'],
    ['Node.js', 'PostgreSQL'],
  ][i],
}));

const timeline = groupExperience(experience);

const skills = t.skills.items.map((name, i) => ({
  name,
  level: [92, 85, 88, 75, 80][i],
}));


---

<Layout lang={lang}>
  <!-- ================= HERO ================= -->
  <section class="hero px-6">
    <div class="hero-inner">
      <h1 class="hero-title">
        <span class="hero-lead">{t.hero.lead}</span>
        <ParticleText text={t.hero.slogan} />
      </h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">{t.hero.ctaProjects}</a>
        <a href="#contact" class="btn btn-ghost">{t.hero.ctaContact}</a>
        <button
          type="button"
          class="btn btn-ghost !px-3"
          data-replay-intro
          aria-label={t.ui.replayIntro}
          title={t.ui.replayIntro}
        >
          <SkinIcon modern="lucide:sparkles" pixel="pixelarticons:sparkles" />
        </button>
      </div>
    </div>
  </section>

  <!-- ================= PROJECTS ================= -->
  <section id="projects" class="mx-auto max-w-5xl px-6 py-20">
    <p class="section-label">{t.projects.label}</p>
    <h2 class="mt-2 text-3xl font-bold">
      <span class="modern-only">{t.projects.headingModern}</span>
      <span class="pixel-only">{t.projects.headingPixel}</span>
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3 md:grid-rows-2">
      <!-- Featured project: spans 2x2 in the bento grid -->
      <article class="card card-hover flex flex-col p-7 md:col-span-2 md:row-span-2">
        <span class="section-label text-xs">
          <span class="pixel-only">LVL </span>{projects[0].level} · {t.projects.featured}
        </span>
        <h3 class="mt-3 text-2xl font-bold">{projects[0].title}</h3>
        <p class="mt-3 max-w-lg leading-relaxed" style="color: var(--muted)">
          {projects[0].description}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {projects[0].stack.map((tech) => <span class="chip">{tech}</span>)}
        </div>
        <!-- Screenshot placeholder: replace with a real project screenshot -->
        <div
          class="mt-6 flex flex-1 flex-col overflow-hidden"
          style="border: var(--border-w) solid var(--border); border-radius: var(--radius-sm); min-height: 200px"
        >
          <div class="flex gap-1.5 px-3 py-2" style="border-bottom: var(--border-w) solid var(--border)">
            <span class="inline-block h-2.5 w-2.5 rounded-full" style="background:#f87171"></span>
            <span class="inline-block h-2.5 w-2.5 rounded-full" style="background:#fbbf24"></span>
            <span class="inline-block h-2.5 w-2.5 rounded-full" style="background:#34d399"></span>
          </div>
          <div
            class="flex flex-1 items-center justify-center text-sm"
            style="background: linear-gradient(135deg, var(--accent-soft), var(--bg-soft)); color: var(--muted)"
          >
            {t.projects.screenshotPlaceholder}
          </div>
        </div>
      </article>

      {projects.slice(1).map((project) => (
        <article class="card card-hover flex flex-col p-6">
          <span class="section-label text-xs">
            <span class="pixel-only">LVL </span>{project.level}
          </span>
          <h3 class="mt-3 text-xl font-bold">{project.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: var(--muted)">
            {project.description}
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.stack.map((tech) => <span class="chip">{tech}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= PROFILE ================= -->
  <section id="profile" class="mx-auto max-w-5xl px-6 py-24">
    <p class="section-label">{t.profile.label}</p>
    <div class="profile mt-8">
      <figure class="profile-photo">
        <Image
          class="modern-only"
          src={profilePhoto}
          alt={t.profile.photoAlt}
          widths={[340, 680, 1020]}
          sizes="(min-width: 768px) 340px, 100vw"
        />
        <!-- Genuinely downscaled, then blown back up by CSS: real pixel art -->
        <Image class="pixel-only" src={profilePhoto} alt="" width={104} densities={[1]} />
      </figure>

      <div>
        <h2 class="text-3xl font-bold">Yannick Desiron</h2>
        <p class="mt-2 text-lg" style="color: var(--muted)">
          {t.profile.role}
        </p>
        <p class="mt-6 max-w-xl leading-relaxed" style="color: var(--muted)">
          {t.profile.bio}
        </p>

        <dl class="profile-facts mt-10">
          <div>
            <dt>{t.profile.facts.role}</dt>
            <dd>{t.profile.facts.roleValue}</dd>
          </div>
          <div>
            <dt>{t.profile.facts.company}</dt>
            <dd>CrediBill</dd>
          </div>
          <div>
            <dt>{t.profile.facts.location}</dt>
            <dd>{t.profile.facts.locationValue}</dd>
          </div>
          <div>
            <dt>{t.profile.facts.stack}</dt>
            <dd>PHP · TypeScript · MySQL</dd>
          </div>
          <div>
            <dt>{t.profile.facts.background}</dt>
            <dd>{t.profile.facts.backgroundValue}</dd>
          </div>
          <div>
            <dt>{t.profile.facts.status}</dt>
            <dd style="color: var(--accent)">{t.profile.facts.statusValue}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= STORY / TIMELINE ================= -->
  <section id="story" class="band px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <p class="section-label">{t.story.label}</p>
      <h2 class="mt-2 text-3xl font-bold">{t.story.heading}</h2>
      <p class="mt-4 max-w-xl" style="color: var(--muted)">
        {t.story.intro}
      </p>

      <div class="story-body">
        <figure class="story-photo">
          <Image
            class="modern-only"
            src={courtPhoto}
            alt={t.story.photoAlt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 400px, 100vw"
          />
          <Image class="pixel-only" src={courtPhoto} alt="" width={96} densities={[1]} />
        </figure>

        <ol class="timeline">
          {timeline.map((entry) => {
            const kind = entry.group ? 'court' : entry.item.kind;
            const start = entry.group ? entry.start : entry.item.start;
            const end = entry.group ? entry.end : entry.item.end;
            const role = entry.group ? entry.role : entry.item.role;
            return (
              <li class="timeline-item" data-kind={kind}>
                <span class="timeline-dot"></span>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="section-label text-xs">{formatPeriod(lang, start, end)}</span>
                  <span class="tl-kind">
                    {kind === 'code' ? (
                      <SkinIcon modern="lucide:code-xml" pixel="pixelarticons:code" />
                    ) : (
                      <SkinIcon modern="lucide:dribbble" pixel="pixelarticons:human-run" />
                    )}
                    {kind === 'code' ? t.story.kindCode : t.story.kindCourt}
                  </span>
                </div>
                <h3 class="mt-1 text-lg font-bold">{t.story.roles[role]}</h3>
                {entry.group ? (
                  <ul class="tl-clubs mt-1.5">
                    {entry.orgs.map((org) => (
                      <li>{org}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-0.5 font-semibold">{entry.item.org}</p>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= SKILLS ================= -->
  <section id="skills" class="mx-auto max-w-3xl px-6 py-20">
    <p class="section-label">{t.skills.label}</p>
    <h2 class="mt-2 text-3xl font-bold">
      <span class="modern-only">{t.skills.headingModern}</span>
      <span class="pixel-only">{t.skills.headingPixel}</span>
    </h2>
    <div class="mt-10 flex flex-col gap-6">
      {skills.map((skill) => (
        <div>
          <div class="mb-2 flex items-baseline justify-between">
            <span class="font-semibold">{skill.name}</span>
            <span class="text-sm" style="color: var(--muted); font-family: var(--font-mono)">
              {skill.level}
            </span>
          </div>
          <div class="skill-track">
            <div class="skill-fill" style={`--level: ${skill.level}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section id="contact" class="band px-6 py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-label">{t.contact.label}</p>
      <h2 class="mt-2 text-3xl font-bold">
        <span class="modern-only">{t.contact.headingModern}</span>
        <span class="pixel-only">{t.contact.headingPixel}</span>
      </h2>
      <p class="mx-auto mt-4 max-w-md" style="color: var(--muted)">
        {t.contact.intro}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="mailto:hello@example.com" class="btn btn-primary">
          <SkinIcon modern="lucide:mail" pixel="pixelarticons:mail" /> {t.contact.mail}
        </a>
        <a href="https://github.com/" class="btn btn-ghost" rel="noopener">
          <SkinIcon modern="lucide:github" pixel="pixelarticons:github" /> GitHub
        </a>
        <a href="https://www.linkedin.com/" class="btn btn-ghost" rel="noopener">
          <SkinIcon modern="lucide:linkedin" pixel="pixelarticons:linkedin" /> LinkedIn
        </a>
        <a href={`${pathFor(lang)}cv`} class="btn btn-ghost">
          <SkinIcon modern="lucide:file-text" pixel="pixelarticons:article" /> {t.cv.link}
        </a>
      </div>
    </div>
  </section>
</Layout>
