---
import Layout from '../layouts/Layout.astro';
import SkinIcon from './SkinIcon.astro';
import { formatPeriod, pathFor, useTranslations, type Lang } from '../i18n';
import { contact, experience, groupExperience } from '../data/experience';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Dezelfde samenvatting als de tijdlijn op de homepage: veertien jaar sport
// als één vermelding met de clubs erbij, in plaats van zes identieke regels
// die de IT-functies wegdrukken.
const entries = groupExperience(experience);

// Een link op papier zonder adres is onbruikbaar; de afdrukstijl zet het
// adres erachter, dus de zichtbare tekst mag kort blijven.
const short = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Layout lang={lang} title={t.cv.title} description={t.cv.description} plain>
  <article class="cv mx-auto max-w-5xl px-6 py-16">
    <header class="cv-head">
      <div>
        <p class="section-label">{t.cv.heading}</p>
        <h1 class="cv-name">Yannick Desiron</h1>
        <p class="cv-role">{t.profile.role}</p>
        <p class="cv-meta">
          {t.cv.locationValue} · {t.cv.languagesValue}
        </p>
      </div>
      <button type="button" id="cv-print" class="btn btn-ghost cv-print">
        <SkinIcon modern="lucide:printer" pixel="pixelarticons:printer" />
        {t.cv.print}
      </button>
    </header>

    <p class="cv-intro">{t.profile.bio}</p>

    <div class="cv-layout">
      <main>
        <section class="cv-section">
          <h2>{t.cv.experience}</h2>
          <ol class="cv-list">
            {entries.map((entry) => {
              const start = entry.group ? entry.start : entry.item.start;
              const end = entry.group ? entry.end : entry.item.end;
              const role = entry.group ? entry.role : entry.item.role;
              return (
                <li class="cv-entry">
                  <p class="cv-period">{formatPeriod(lang, start, end)}</p>
                  <div>
                    <h3>{t.story.roles[role]}</h3>
                    {entry.group ? (
                      <p class="cv-org">{entry.orgs.join(' · ')}</p>
                    ) : (
                      <p class="cv-org">{entry.item.org}</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      </main>

      <aside class="cv-aside">
        <section class="cv-section">
          <h2>{t.cv.skills}</h2>
          <ul class="cv-tags">
            {t.skills.items.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>

        <section class="cv-section">
          <h2>{t.cv.contact}</h2>
          <ul class="cv-contact">
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a href={contact.github} rel="noopener">{short(contact.github)}</a></li>
            <li><a href={contact.linkedin} rel="noopener">{short(contact.linkedin)}</a></li>
          </ul>
        </section>
      </aside>
    </div>

    <p class="cv-back">
      <a href={pathFor(lang)}>{t.cv.backToSite}</a>
    </p>
  </article>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.getElementById('cv-print')?.addEventListener('click', () => window.print());
  });
</script>
